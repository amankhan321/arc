# ---- AgentWallet config (Arc Testnet) ----

# The HUMAN owner's wallet. Funds the unified balance and authorizes the agent.
# Test key only — never a real-funds key. (with or without 0x prefix)
OWNER_PRIVATE_KEY=

# The AGENT's wallet. Receives the delegated spending allowance and signs spends.
# Generate a fresh throwaway key for this.
AGENT_PRIVATE_KEY=

# The spending cap, in USDC, that the agent may spend in total (app-enforced).
AGENT_BUDGET_USDC=10

# Where the agent sends payments in the demo (a "service" it pays).
# Defaults to the owner's own address if left blank.
DEMO_RECIPIENT=

# How much the owner deposits into the unified balance at the start of the demo.
# Set to 0 to skip depositing (e.g. if already funded).
DEMO_DEPOSIT_USDC=0

# Arc Testnet RPC. The default public endpoint is fine.
ARC_RPC=https://rpc.testnet.arc.network/

# --- Dashboard only ---
# Force the dashboard into mock/demo mode even if keys are set (1 = mock).
# Leave blank to run live when keys are present.
DEMO_MODE=
# Port for the dashboard server (default 5173).
PORT=5173

# --- On-chain contract (AgentAllowance) ---
# Deploy key, funded with Arc Testnet USDC (from the Circle Faucet).
DEPLOYER_PRIVATE_KEY=
# Arc Testnet USDC token address (ERC-20 interface). Default is correct.
USDC_ADDRESS=0x3600000000000000000000000000000000000000
# Set after deploying, to run the interact script.
CONTRACT_ADDRESS=
